          outputs: { api: "\${{ fromJSON(steps.detect.outputs.changes).api }}", docs: "\${{ fromJSON(steps.detect.outputs.changes).docs }}", web: "\${{ fromJSON(steps.detect.outputs.changes).web }}", changes: "\${{ steps.detect.outputs.changes }}", affectedDomains: "\${{ steps.detect.outputs.affectedDomains }}" }
